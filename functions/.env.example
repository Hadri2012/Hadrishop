# Variables lues par le serveur (Cloud Function). En production, ce fichier est GÉNÉRÉ par GitHub Actions
# à partir des « secrets » du dépôt : ne mettez jamais de vraie clé dans un fichier commité.

# Adresse publique du site (https://<id-du-projet>.web.app ou votre domaine)
APP_URL=https://mon-projet.web.app
# Autres adresses autorisées (séparées par des virgules), ex. le domaine .firebaseapp.com
EXTRA_ORIGINS=https://mon-projet.firebaseapp.com

# Stripe — commencez en mode TEST (sk_test_...)
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# E-mails (SMTP) : smtps://utilisateur:motdepasse@serveur:465
SMTP_URL=smtps://utilisateur:motdepasse@smtp.exemple.be:465
MAIL_FROM="HADRISHOP <boutique@exemple.be>"
ADMIN_NOTIFY_EMAIL=vous@exemple.be

# Premier administrateur : ce compte devient admin quand il confirme son adresse e-mail
ADMIN_EMAIL=vous@exemple.be

# Codes postaux pour le rayon de 30 km : none (import/saisie dans /admin) ou nominatim (OpenStreetMap)
GEOCODER=none
GEOCODER_CONTACT=vous@exemple.be
