# --- Copiez ce fichier en .env et complétez-le. Ne le partagez jamais (il contient des secrets). ---

NODE_ENV=production
PORT=3000
# Adresse publique du site, en https:// (sert aux liens des e-mails, aux retours Stripe et au contrôle anti-CSRF)
APP_URL=https://boutique.exemple.be
# Dossier de données persistantes (base SQLite + fichiers téléversés). Doit être sauvegardé.
DATA_DIR=/data
# Derrière un proxy (Caddy, Nginx, hébergeur) : nombre de proxys de confiance
TRUST_PROXY=1

# --- Stripe (Dashboard Stripe > Développeurs > Clés API / Webhooks) ---
# Commencez en mode TEST (sk_test_...), passez en sk_live_... seulement après vos essais.
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# --- E-mails (n'importe quel fournisseur SMTP : Brevo, OVH, Infomaniak, Gmail avec mot de passe d'application…) ---
# Format : smtps://utilisateur:motdepasse@serveur:465   ou   smtp://utilisateur:motdepasse@serveur:587
SMTP_URL=smtps://utilisateur:motdepasse@smtp.exemple.be:465
MAIL_FROM="HADRISHOP <boutique@exemple.be>"
# Adresse qui reçoit les alertes (nouvelle commande, demande sur mesure, demande de remboursement)
ADMIN_NOTIFY_EMAIL=vous@exemple.be

# --- Géolocalisation des codes postaux pour le rayon de livraison ---
# none = uniquement les codes importés (GeoNames) ou saisis dans /admin
# nominatim = complète automatiquement via OpenStreetMap (1 requête/s max, résultats mis en cache)
GEOCODER=none
GEOCODER_CONTACT=vous@exemple.be
